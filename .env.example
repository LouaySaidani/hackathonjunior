# ------------------------------------------------------------------
# Basira - configuration. Copy to .env and fill what you need.
# Without any key the app runs in DEMO MODE (clearly labelled).
# Secrets stay server-side: they are never sent to the browser.
# ------------------------------------------------------------------

# --- Speech recognition -------------------------------------------
# auto = faster-whisper, falls back to demo if the model cannot be loaded
ASR_PROVIDER=auto            # auto | whisper | demo
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 | <HF repo id of a CTranslate2 model>
                             # e.g. a Tunisian/darija fine-tune converted with ct2-transformers-converter
WHISPER_COMPUTE_TYPE=int8    # int8 (CPU) | float16 (GPU)
WHISPER_DEVICE=cpu           # cpu | cuda

# --- Vision-language model (keyframes -> description drafts) --------
VLM_PROVIDER=auto            # auto | gemini | openai | demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when a model's daily quota is used up (free tier: ~20 requests/day/model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
VLM_BATCH_SIZE=8             # silent slots described per request (saves quota)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (vLLM, Ollama /v1, OpenRouter...)
OPENAI_MODEL=gpt-4o-mini

# --- Text-to-speech -------------------------------------------------
TTS_PROVIDER=auto            # auto (edge -> espeak -> demo tone) | edge | espeak | demo
TTS_VOICE_FR=fr-FR-DeniseNeural
TTS_VOICE_AR=ar-TN-ReemNeural
TTS_VOICE_EN=en-GB-SoniaNeural

# --- Pipeline -------------------------------------------------------
VAD_ENGINE=silero            # silero | webrtc
MIN_GAP_SECONDS=1.5
GAP_PADDING_SECONDS=0.25
MAX_SLOT_SECONDS=10          # long silences are split into slots (at shot changes); 0 = never split
# ML gap selection (model trained by ml/run_all.py): auto | model | all
GAP_SELECTION=auto
GAP_SCORE_THRESHOLD=0           # 0 = threshold learned during training
SCENE_THRESHOLD=0.3
MAX_KEYFRAMES_PER_GAP=3
CONFIDENCE_THRESHOLD=0.6     # below -> "needs human review"
DUCK_VOLUME=0.25             # original audio level during descriptions

# --- Storage --------------------------------------------------------
# DATA_DIR=./data
# MODELS_DIR=./models
MAX_UPLOAD_MB=500
SEED_SAMPLE=true             # preload the CC0 sample clip on first start
# Video of the sample project. Empty = the bundled CC0 clip (with its reference script).
# Put a local video in samples/local/ (git-ignored) to use it instead, e.g.:
# SAMPLE_VIDEO=samples/local/mon_extrait.mp4
# SAMPLE_TITLE=Exemple — mon extrait
